{
  "openapi": "3.1.0",
  "info": {
    "title": "Antre API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "staffKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-staff-key"
      }
    },
    "schemas": {
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "number": {
            "type": "integer"
          },
          "day": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "called"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "day",
          "status",
          "createdAt"
        ]
      },
      "QueueState": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "current": {
            "type": [
              "integer",
              "null"
            ]
          },
          "waiting": {
            "type": "integer"
          },
          "next": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "maxItems": 5
          }
        },
        "required": [
          "day",
          "current",
          "waiting",
          "next"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "QueueStats": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "taken": {
            "type": "integer"
          },
          "called": {
            "type": "integer"
          },
          "waiting": {
            "type": "integer"
          }
        },
        "required": [
          "day",
          "taken",
          "called",
          "waiting"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/tickets": {
      "post": {
        "operationId": "takeNumber",
        "responses": {
          "201": {
            "description": "The ticket given to the visitor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          }
        }
      }
    },
    "/state": {
      "get": {
        "operationId": "readState",
        "responses": {
          "200": {
            "description": "What the display board shows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueState"
                }
              }
            }
          }
        }
      }
    },
    "/call-next": {
      "post": {
        "operationId": "callNext",
        "security": [
          {
            "staffKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "The ticket that is now on the board",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "401": {
            "description": "The staff key is missing or wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Nobody is waiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "operationId": "readStats",
        "security": [
          {
            "staffKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Today's counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueStats"
                }
              }
            }
          },
          "401": {
            "description": "The staff key is missing or wrong",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
